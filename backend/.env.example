# Jarvis VIP Secure Backend Configuration
PORT=8080

# Required: Your OpenAI API key (never packaged in the Android APK)
OPENAI_API_KEY=

# Optional: OpenAI chat model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Authentication (configure at least ONE):
# 1. Shared bearer token for direct Android client pairing
JARVIS_SHARED_TOKEN=
# 2. Path to Firebase service account JSON for verifying Firebase Auth ID tokens
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: Comma-separated allowed CORS origins (empty disables cross-origin browser access)
ALLOWED_ORIGINS=
